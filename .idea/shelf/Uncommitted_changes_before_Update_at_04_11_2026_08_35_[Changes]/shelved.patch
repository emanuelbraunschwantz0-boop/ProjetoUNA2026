-// ============================================================
-// MASKS
-// ============================================================
-function maskTel(inp) {
-  let v = inp.value.replace(/\D/g, '').substring(0, 11);
-  if (v.length > 10) v = v.replace(/^(\d{2})(\d{1})(\d{4})(\d{4})$/, '($1) $2 $3-$4');
