-// ============================================================
-// FOTO PREVIEW
-// ============================================================
-function previewFoto(inp) {
-  const file = inp.files[0];
-  if (!file) return;
-  if (file.size > 2 * 1024 * 1024) { alert('A imagem deve ter no máximo 2MB.'); return; }
-  const reader = new FileReader();
