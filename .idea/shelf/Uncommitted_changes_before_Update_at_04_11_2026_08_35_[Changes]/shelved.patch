-  hashAssinatura: null,
-  canvasDirty: false,
-  ipUsuario: '...',
-};
-
-// ============================================================
-// MAPAS DE DOCUMENTOS
-// ============================================================
-const DOCS = {
-  uso: {
-    tag: 'Termos de Uso',
-    titulo: 'Termos de <em>Uso e Condições</em>',
-    secao: 'sec-uso',
-    tab: 'tab-uso',
-    sumario: [
-      { id:'art-1', num:'01', txt:'Aceitação dos Termos' },
-      { id:'art-2', num:'02', txt:'Definições e Partes' },
-      { id:'art-3', num:'03', txt:'Cadastro e Conta' },
