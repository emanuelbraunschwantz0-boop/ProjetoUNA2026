<+>/* ===================== RESET & VARS ===================== */\r\n*{box-sizing:border-box;margin:0;padding:0;}\r\n:root{\r\n  --marrom:#3D2B1A; --marrom-medio:#6B4226;\r\n  --dourado:#C9A96E; --dourado-claro:#E8D5B0;\r\n  --creme:#FAF5EE; --creme-escuro:#F0E6D3;\r\n  --texto:#2A1A0E;\r\n  --verde:#4CAF7D; --vermelho:#C0392B;\r\n  --roxo:#8E44AD; --azul:#2980B9;\r\n}\r\nhtml,body{height:100%;font-family:'Jost',sans-serif;background:var(--creme);color:var(--texto);overflow-x:hidden;}\r\n\r\n/* ===================== SIDEBAR ===================== */\r\n.sidebar{\r\n  width:220px;min-height:100vh;background:var(--marrom);\r\n  position:fixed;top:0;left:0;\r\n  display:flex;flex-direction:column;align-items:center;\r\n  padding:36px 20px;z-index:100;\r\n  border-right:1px solid rgba(201,169,110,0.2);\r\n  transition:transform 0.3s;\r\n}\r\n.logo-wrap img{\r\n    width:150px;\r\n    height:150px;\r\n    padding-left: 5px;\r\n    margin-bottom: 28px;\r\n}\r\n.logo-nome{\r\n  font-family:'Cormorant Garamond',serif;font-size:12px;letter-spacing:4px;\r\n  color:var(--dourado-claro);text-transform:uppercase;margin-bottom:10px;opacity:0.7;text-align:center;\r\n}\r\n.user-badge{\r\n  display:flex;align-items:center;gap:8px;\r\n  background:rgba(201,169,110,0.1);border-radius:8px;padding:8px 12px;\r\n  margin-bottom:32px;width:100%;\r\n}\r\n.user-badge .avatar{\r\n  width:28px;height:28px;border-radius:50%;background:var(--dourado);\r\n  display:flex;align-items:center;justify-content:center;\r\n  font-size:11px;font-weight:600;color:var(--marrom);flex-shrink:0;\r\n}\r\n.user-badge .info .nome-user{font-size:12px;color:var(--dourado-claro);font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:110px;}\r\n.user-badge .info .tipo-user{font-size:10px;letter-spacing:1px;text-transform:uppercase;color:rgba(201,169,110,0.5);}\r\n\r\n.sidebar nav{width:100%;}\r\n.sidebar nav ul{list-style:none;}\r\n.sidebar nav ul li{margin-bottom:4px;}\r\n.sidebar nav ul li a{\r\n  display:flex;align-items:center;gap:12px;text-decoration:none;\r\n  color:rgba(232,213,176,0.55);font-size:12px;letter-spacing:2px;\r\n  text-transform:uppercase;padding:10px 12px;border-radius:8px;transition:all 0.3s;\r\n  cursor:pointer;\r\n}\r\n.sidebar nav ul li a i{font-size:15px;}\r\n.sidebar nav ul li a:hover{color:var(--dourado-claro);background:rgba(201,169,110,0.1);padding-left:18px;}\r\n.sidebar nav ul li.ativo a{color:#fff;background:rgba(201,169,110,0.14);padding-left:18px;}\r\n.sidebar nav ul li.separador{height:1px;background:rgba(201,169,110,0.1);margin:12px 0;}\r\n\r\n.sidebar-footer{\r\n  margin-top:auto;width:100%;\r\n}\r\n.btn-sair{\r\n  display:flex;align-items:center;gap:10px;\r\n  padding:10px 12px;border-radius:8px;cursor:pointer;\r\n  color:rgba(232,213,176,0.35);font-size:12px;letter-spacing:2px;text-transform:uppercase;\r\n  border:none;background:none;width:100%;font-family:'Jost',sans-serif;\r\n  transition:all 0.3s;\r\n}\r\n.btn-sair:hover{color:rgba(192,57,43,0.8);background:rgba(192,57,43,0.08);}\r\n.rodape-texto{font-size:10px;letter-spacing:1px;color:rgba(201,169,110,0.2);text-align:center;line-height:1.8;margin-top:12px;}\r\n\r\n/* ===================== MAIN ===================== */\r\n.main{margin-left:220px;min-height:100vh;display:flex;flex-direction:column;}\r\n\r\n/* ===================== PAGE HEADER ===================== */\r\n.page-header{\r\n  background:linear-gradient(120deg,#3D2B1A 0%,#5C3D22 55%,#7A5230 100%);\r\n  padding:52px 64px 44px;position:relative;overflow:hidden;\r\n}\r\n.ph-deco{\r\n  position:absolute;right:-100px;top:-100px;\r\n  width:500px;height:500px;border-radius:50%;\r\n  border:1px solid rgba(201,169,110,0.08);pointer-events:none;\r\n}\r\n.ph-deco2{\r\n  position:absolute;right:-50px;top:-50px;\r\n  width:320px;height:320px;border-radius:50%;\r\n  border:1px solid rgba(201,169,110,0.06);pointer-events:none;\r\n}\r\n.ph-linha{position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--dourado),transparent);}\r\n.ph-tag{\r\n  display:inline-block;font-size:10px;letter-spacing:4px;text-transform:uppercase;\r\n  color:var(--dourado);border:1px solid rgba(201,169,110,0.35);\r\n  padding:4px 14px;border-radius:20px;margin-bottom:14px;\r\n}\r\n.ph-titulo{\r\n  font-family:'Cormorant Garamond',serif;font-size:clamp(28px,3.5vw,46px);\r\n  font-weight:300;color:#fff;line-height:1.2;\r\n}\r\n.ph-titulo em{font-style:italic;color:var(--dourado);}\r\n.ph-sub{font-size:13px;letter-spacing:0.5px;color:rgba(232,213,176,0.5);margin-top:8px;}\r\n\r\n/* ===================== CONTEÚDO ===================== */\r\n.conteudo{padding:40px 64px 64px;flex:1;}\r\n\r\n/* ===================== SEÇÕES ===================== */\r\n.secao{display:none;}\r\n.secao.ativa{display:block;animation:fadeUp 0.4s ease both;}\r\n@keyframes fadeUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}\r\n\r\n/* ===================== UTILS ===================== */\r\n.label-sec{font-size:10px;letter-spacing:4px;text-transform:uppercase;color:var(--dourado);display:block;margin-bottom:16px;}\r\n.titulo-sec{font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:300;color:var(--marrom);margin-bottom:6px;}\r\n.titulo-sec em{font-style:italic;color:var(--marrom-medio);}\r\n.sub-sec{font-size:13px;color:rgba(61,43,26,0.45);letter-spacing:0.3px;margin-bottom:32px;}\r\n\r\n.card{background:#fff;border-radius:12px;border:1px solid var(--creme-escuro);padding:28px;}\r\n.card-sm{background:#fff;border-radius:10px;border:1px solid var(--creme-escuro);padding:20px;}\r\n\r\n/* BOTÕES */\r\n.btn-pri{\r\n  padding:12px 28px;background:var(--dourado);color:var(--marrom);border:none;\r\n  font-size:11px;letter-spacing:2.5px;text-transform:uppercase;font-family:'Jost',sans-serif;font-weight:500;\r\n  border-radius:6px;cursor:pointer;transition:all 0.3s;display:inline-flex;align-items:center;gap:8px;\r\n}\r\n.btn-pri:hover{background:var(--dourado-claro);transform:translateY(-1px);}\r\n.btn-pri:disabled{opacity:0.35;cursor:not-allowed;transform:none;}\r\n.btn-sec{\r\n  padding:12px 28px;border:1.5px solid rgba(201,169,110,0.35);color:var(--marrom-medio);\r\n  background:transparent;font-size:11px;letter-spacing:2.5px;text-transform:uppercase;\r\n  font-family:'Jost',sans-serif;border-radius:6px;cursor:pointer;transition:all 0.3s;\r\n  display:inline-flex;align-items:center;gap:8px;\r\n}\r\n.btn-sec:hover{border-color:var(--dourado);color:var(--marrom);}\r\n.btn-ghost{\r\n  padding:8px 16px;border:1px solid rgba(201,169,110,0.25);color:rgba(61,43,26,0.5);\r\n  background:transparent;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;\r\n  font-family:'Jost',sans-serif;border-radius:6px;cursor:pointer;transition:all 0.2s;\r\n  display:inline-flex;align-items:center;gap:6px;\r\n}\r\n.btn-ghost:hover{border-color:var(--dourado);color:var(--marrom);}\r\n.btn-danger{\r\n  padding:8px 16px;border:1px solid rgba(192,57,43,0.25);color:#C0392B;\r\n  background:transparent;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;\r\n  font-family:'Jost',sans-serif;border-radius:6px;cursor:pointer;transition:all 0.2s;\r\n}\r\n.btn-danger:hover{background:rgba(192,57,43,0.08);}\r\n\r\n/* INPUTS */\r\n.inp{\r\n  width:100%;padding:11px 14px;border:1.5px solid var(--creme-escuro);border-radius:8px;\r\n  font-family:'Jost',sans-serif;font-size:13px;color:var(--texto);background:#fff;outline:none;\r\n  transition:border 0.2s;\r\n}\r\n.inp:focus{border-color:var(--dourado);}\r\n.inp::placeholder{color:rgba(61,43,26,0.2);}\r\n.inp-label{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:rgba(61,43,26,0.4);display:block;margin-bottom:7px;}\r\n.campo-f{margin-bottom:18px;}\r\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px;}\r\n.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;}\r\n\r\n/* ===================== STEPS (cliente) ===================== */\r\n.steps-bar{display:flex;align-items:center;gap:0;margin-bottom:36px;}\r\n.step{display:flex;align-items:center;gap:8px;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:rgba(61,43,26,0.3);transition:all 0.3s;}\r\n.step.ativo{color:var(--marrom);}\r\n.step.done{color:var(--dourado);}\r\n.step-num{\r\n  width:26px;height:26px;border-radius:50%;border:1.5px solid currentColor;\r\n  display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:500;flex-shrink:0;\r\n}\r\n.step.ativo .step-num{background:var(--marrom);color:#fff;border-color:var(--marrom);}\r\n.step.done .step-num{background:var(--dourado);color:var(--marrom);border-color:var(--dourado);}\r\n.step-linha{flex:1;height:1px;background:rgba(201,169,110,0.25);margin:0 14px;}\r\n\r\n/* ===================== CARDS SERVIÇO ===================== */\r\n.grade-servicos{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:14px;margin-bottom:28px;}\r\n.serv-card{\r\n  border:1.5px solid var(--creme-escuro);border-radius:10px;padding:20px 16px;\r\n  cursor:pointer;transition:all 0.3s;background:#fff;position:relative;\r\n}\r\n.serv-card:hover{border-color:rgba(201,169,110,0.5);transform:translateY(-2px);}\r\n.serv-card.sel{border-color:var(--dourado);background:rgba(201,169,110,0.07);}\r\n.serv-card.sel::after{\r\n  content:'✓';position:absolute;top:10px;right:12px;\r\n  width:18px;height:18px;border-radius:50%;background:var(--dourado);\r\n  display:grid;place-items:center;font-size:10px;color:var(--marrom);font-weight:700;\r\n}\r\n.serv-ico{width:38px;height:38px;border-radius:8px;background:var(--creme-escuro);display:flex;align-items:center;justify-content:center;font-size:17px;color:var(--dourado);margin-bottom:12px;}\r\n.serv-card h4{font-family:'Cormorant Garamond',serif;font-size:17px;font-weight:400;color:var(--marrom);margin-bottom:3px;}\r\n.serv-card .dur{font-size:11px;letter-spacing:0.5px;color:rgba(61,43,26,0.4);}\r\n.serv-card .preco{font-family:'Cormorant Garamond',serif;font-size:19px;color:var(--dourado);margin-top:10px;font-weight:300;}\r\n\r\n/* ===================== CARDS PROF ===================== */\r\n.grade-prof{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:28px;}\r\n.prof-card{\r\n  display:flex;align-items:center;gap:12px;padding:14px 18px;\r\n  border:1.5px solid var(--creme-escuro);border-radius:10px;\r\n  cursor:pointer;transition:all 0.3s;background:#fff;min-width:200px;\r\n}\r\n.prof-card:hover{border-color:rgba(201,169,110,0.5);}\r\n.prof-card.sel{border-color:var(--dourado);background:rgba(201,169,110,0.07);}\r\n.prof-av{\r\n  width:44px;height:44px;border-radius:50%;background:var(--marrom);\r\n  display:flex;align-items:center;justify-content:center;\r\n  font-family:'Cormorant Garamond',serif;font-size:16px;color:var(--dourado-claro);flex-shrink:0;\r\n}\r\n.prof-card h4{font-size:13px;font-weight:500;color:var(--marrom);}\r\n.prof-card span{font-size:11px;color:rgba(61,43,26,0.45);}\r\n.online-dot{width:8px;height:8px;border-radius:50%;background:var(--verde);margin-left:auto;flex-shrink:0;}\r\n\r\n/* ===================== CALENDÁRIO ===================== */\r\n.data-grid{display:grid;grid-template-columns:300px 1fr;gap:24px;margin-bottom:28px;}\r\n.cal{background:#fff;border-radius:12px;border:1px solid var(--creme-escuro);padding:22px;}\r\n.cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;}\r\n.cal-head h3{font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:400;color:var(--marrom);}\r\n.cal-nav-btn{\r\n  width:30px;height:30px;border-radius:50%;border:1px solid var(--creme-escuro);\r\n  background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;\r\n  color:var(--marrom-medio);font-size:13px;transition:all 0.2s;\r\n}\r\n.cal-nav-btn:hover{border-color:var(--dourado);color:var(--dourado);}\r\n.dsem{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;margin-bottom:6px;}\r\n.dsem div{text-align:center;font-size:10px;letter-spacing:1px;text-transform:uppercase;color:rgba(61,43,26,0.3);padding:3px 0;}\r\n.cal-grade{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;}\r\n.cdia{\r\n  aspect-ratio:1;display:flex;align-items:center;justify-content:center;\r\n  border-radius:5px;cursor:pointer;font-size:12px;color:var(--texto);\r\n  transition:all 0.15s;border:1px solid transparent;position:relative;\r\n}\r\n.cdia:hover:not(.vazio):not(.pass){background:var(--creme-escuro);}\r\n.cdia.vazio,.cdia.pass{color:rgba(61,43,26,0.2);pointer-events:none;}\r\n.cdia.hoje{font-weight:600;color:var(--dourado);}\r\n.cdia.sel{background:var(--marrom);color:#fff !important;border-color:var(--marrom);}\r\n.cdia.tem-vaga::after{\r\n  content:'';position:absolute;bottom:2px;left:50%;transform:translateX(-50%);\r\n  width:3px;height:3px;border-radius:50%;background:var(--dourado);\r\n}\r\n.cdia.sem-vaga{color:rgba(61,43,26,0.2);pointer-events:none;}\r\n\r\n/* HORÁRIOS */\r\n.horarios-box{background:#fff;border-radius:12px;border:1px solid var(--creme-escuro);padding:22px;}\r\n.horarios-box h4{font-family:'Cormorant Garamond',serif;font-size:19px;font-weight:400;color:var(--marrom);margin-bottom:4px;}\r\n.horarios-box .data-txt{font-size:11px;letter-spacing:2px;color:var(--dourado);margin-bottom:18px;display:block;text-transform:uppercase;}\r\n.turnos{display:flex;flex-direction:column;gap:18px;}\r\n.turno-label{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:rgba(61,43,26,0.35);margin-bottom:8px;}\r\n.grade-h{display:flex;flex-wrap:wrap;gap:8px;}\r\n.hbtn{\r\n  padding:8px 14px;border-radius:6px;border:1.5px solid var(--creme-escuro);\r\n  background:#fff;cursor:pointer;font-size:12px;font-family:'Jost',sans-serif;\r\n  color:var(--texto);transition:all 0.2s;\r\n}\r\n.hbtn:hover{border-color:var(--dourado);}\r\n.hbtn.sel{background:var(--marrom);color:#fff;border-color:var(--marrom);}\r\n.hbtn.ocup{color:rgba(61,43,26,0.2);border-color:rgba(61,43,26,0.08);cursor:not-allowed;text-decoration:line-through;font-size:11px;}\r\n\r\n/* ===================== RESUMO / PAGAMENTO ===================== */\r\n.resumo-pag-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;}\r\n.resumo-card{background:#fff;border-radius:12px;border:1px solid var(--creme-escuro);padding:28px;}\r\n.resumo-titulo{font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:300;color:var(--marrom);margin-bottom:22px;}\r\n.resumo-titulo em{font-style:italic;color:var(--marrom-medio);}\r\n.rl{display:flex;align-items:center;gap:14px;padding:12px 0;border-bottom:1px solid var(--creme-escuro);}\r\n.rl:last-of-type{border-bottom:none;}\r\n.rl-ico{width:34px;height:34px;border-radius:7px;background:var(--creme-escuro);display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--dourado);flex-shrink:0;}\r\n.rl-info label{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:rgba(61,43,26,0.35);}\r\n.rl-info p{font-size:14px;color:var(--marrom);margin-top:2px;}\r\n.total-linha{display:flex;align-items:center;justify-content:space-between;padding-top:16px;margin-top:6px;}\r\n.total-linha .tl{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:rgba(61,43,26,0.4);}\r\n.total-linha .tv{font-family:'Cormorant Garamond',serif;font-size:30px;color:var(--marrom);font-weight:300;}\r\n.total-linha .tv span{font-size:14px;color:var(--dourado);}\r\n\r\n/* PAGAMENTO */\r\n.metodos-pag{display:flex;flex-direction:column;gap:10px;margin-bottom:20px;}\r\n.metodo{\r\n  display:flex;align-items:center;gap:14px;padding:14px 16px;\r\n  border:1.5px solid var(--creme-escuro);border-radius:10px;cursor:pointer;\r\n  transition:all 0.2s;background:#fff;\r\n}\r\n.metodo:hover{border-color:rgba(201,169,110,0.4);}\r\n.metodo.sel{border-color:var(--dourado);background:rgba(201,169,110,0.07);}\r\n.metodo-ico{width:40px;height:40px;border-radius:8px;background:var(--creme-escuro);display:flex;align-items:center;justify-content:center;font-size:18px;color:var(--marrom-medio);}\r\n.metodo-info h5{font-size:13px;font-weight:500;color:var(--marrom);}\r\n.metodo-info p{font-size:11px;color:rgba(61,43,26,0.4);margin-top:1px;}\r\n.metodo-radio{margin-left:auto;width:16px;height:16px;border-radius:50%;border:1.5px solid var(--creme-escuro);display:flex;align-items:center;justify-content:center;}\r\n.metodo.sel .metodo-radio{border-color:var(--dourado);}\r\n.metodo.sel .metodo-radio::after{content:'';width:8px;height:8px;border-radius:50%;background:var(--dourado);display:block;}\r\n\r\n/* PIX BOX */\r\n.pix-box{\r\n  background:rgba(76,175,125,0.07);border:1px solid rgba(76,175,125,0.2);\r\n  border-radius:10px;padding:18px;text-align:center;margin-top:12px;display:none;\r\n}\r\n.pix-box.visivel{display:block;}\r\n.pix-key{font-family:'Cormorant Garamond',serif;font-size:20px;color:var(--marrom);margin:8px 0;}\r\n.pix-key span{font-size:13px;color:#4CAF7D;}\r\n\r\n/* CARTÃO BOX */\r\n.cartao-box{margin-top:12px;display:none;}\r\n.cartao-box.visivel{display:block;}\r\n\r\n/* ===================== SUCESSO ===================== */\r\n.sucesso-wrap{text-align:center;padding:60px 40px;max-width:520px;margin:0 auto;}\r\n.suc-ico{\r\n  width:80px;height:80px;border-radius:50%;background:rgba(76,175,125,0.1);\r\n  display:flex;align-items:center;justify-content:center;font-size:36px;color:#4CAF7D;\r\n  margin:0 auto 24px;\r\n}\r\n.suc-titulo{font-family:'Cormorant Garamond',serif;font-size:38px;font-weight:300;color:var(--marrom);margin-bottom:10px;}\r\n.suc-titulo em{font-style:italic;color:var(--dourado);}\r\n.suc-desc{font-size:14px;color:rgba(61,43,26,0.5);line-height:1.8;max-width:360px;margin:0 auto 28px;}\r\n.suc-card{\r\n  background:var(--creme-escuro);border-radius:10px;padding:18px 24px;\r\n  font-size:13px;color:var(--marrom);letter-spacing:0.5px;margin-bottom:28px;display:inline-block;\r\n}\r\n.suc-wpp{\r\n  display:inline-flex;align-items:center;gap:8px;\r\n  background:#25D366;color:#fff;padding:12px 24px;border-radius:8px;\r\n  font-size:12px;letter-spacing:2px;text-transform:uppercase;\r\n  border:none;cursor:pointer;font-family:'Jost',sans-serif;margin-right:10px;\r\n}\r\n\r\n/* ===================== PAINEL PROF ===================== */\r\n.stats-bar{display:flex;gap:16px;margin-bottom:32px;}\r\n.stat-box{flex:1;background:#fff;border-radius:10px;border:1px solid var(--creme-escuro);padding:18px 20px;}\r\n.stat-box .sn{font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:300;color:var(--marrom);}\r\n.stat-box .sd{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:rgba(61,43,26,0.35);margin-top:3px;}\r\n.stat-box .sd2{font-size:11px;color:var(--dourado);margin-top:5px;}\r\n\r\n/* SEMANA */\r\n.semana-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;}\r\n.semana-nav h3{font-family:'Cormorant Garamond',serif;font-size:21px;font-weight:300;color:var(--marrom);}\r\n.snav-btns{display:flex;gap:8px;}\r\n.snav-btn{\r\n  padding:7px 12px;border:1px solid var(--creme-escuro);border-radius:6px;\r\n  background:#fff;cursor:pointer;font-size:11px;letter-spacing:1px;text-transform:uppercase;\r\n  font-family:'Jost',sans-serif;color:var(--marrom-medio);transition:all 0.2s;\r\n  display:flex;align-items:center;gap:5px;\r\n}\r\n.snav-btn:hover{border-color:var(--dourado);color:var(--marrom);}\r\n.snav-ico{\r\n  width:28px;height:28px;border-radius:6px;border:1px solid var(--creme-escuro);\r\n  background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;\r\n  color:var(--marrom-medio);font-size:13px;transition:all 0.2s;\r\n}\r\n.snav-ico:hover{border-color:var(--dourado);color:var(--dourado);}\r\n\r\n/* AGENDA GRID */\r\n.agenda-wrap{background:#fff;border-radius:12px;border:1px solid var(--creme-escuro);overflow:hidden;}\r\n.ag-header{display:grid;grid-template-columns:54px repeat(6,1fr);border-bottom:1px solid var(--creme-escuro);}\r\n.ag-col{padding:12px 8px;text-align:center;border-left:1px solid var(--creme-escuro);}\r\n.ag-col:first-child{border-left:none;}\r\n.ag-col .dc{font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:300;color:var(--marrom);}\r\n.ag-col .dn{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:rgba(61,43,26,0.35);}\r\n.ag-col.hoje-c .dc{color:var(--dourado);}\r\n.ag-col.hoje-c .dn{color:rgba(201,169,110,0.7);}\r\n.ag-corpo{display:grid;grid-template-columns:54px repeat(6,1fr);max-height:420px;overflow-y:auto;}\r\n.ag-h{padding:0 6px;display:flex;align-items:flex-start;justify-content:flex-end;padding-top:5px;font-size:10px;color:rgba(61,43,26,0.3);letter-spacing:0.3px;border-right:1px solid var(--creme-escuro);}\r\n.ag-slot{min-height:50px;border-left:1px solid rgba(240,230,211,0.5);border-bottom:1px solid rgba(240,230,211,0.5);padding:3px;}\r\n.ev{border-radius:5px;padding:5px 7px;margin-bottom:2px;font-size:10px;cursor:pointer;transition:all 0.15s;}\r\n.ev:hover{filter:brightness(1.05);transform:scale(1.01);}\r\n.ev.corte{background:rgba(201,169,110,0.15);border-left:2px solid var(--dourado);color:var(--marrom);}\r\n.ev.manicure{background:rgba(192,57,43,0.08);border-left:2px solid #C0392B;color:#6B1F15;}\r\n.ev.tratamento{background:rgba(76,175,125,0.1);border-left:2px solid #4CAF7D;color:#1E5E3A;}\r\n.ev.coloracao{background:rgba(142,68,173,0.08);border-left:2px solid #8E44AD;color:#5B2C6F;}\r\n.ev .eh{font-size:9px;opacity:0.6;}\r\n.ev .en{font-weight:500;margin-top:1px;}\r\n.ev .es{opacity:0.6;font-size:9px;}\r\n\r\n.legenda{display:flex;gap:14px;margin-top:14px;flex-wrap:wrap;}\r\n.leg{display:flex;align-items:center;gap:6px;font-size:11px;color:rgba(61,43,26,0.5);}\r\n.leg-c{width:8px;height:8px;border-radius:2px;}\r\n\r\n/* ===================== GESTÃO SERVIÇOS ===================== */\r\n.servicos-gestao-grid{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start;}\r\n.servicos-lista{}\r\n.serv-row{\r\n  display:flex;align-items:center;gap:16px;padding:16px 20px;\r\n  background:#fff;border-radius:10px;border:1px solid var(--creme-escuro);\r\n  margin-bottom:10px;transition:all 0.2s;\r\n}\r\n.serv-row:hover{border-color:rgba(201,169,110,0.3);}\r\n.serv-row-ico{width:40px;height:40px;border-radius:8px;background:var(--creme-escuro);display:flex;align-items:center;justify-content:center;font-size:17px;color:var(--dourado);flex-shrink:0;}\r\n.serv-row-info{flex:1;}\r\n.serv-row-info h4{font-family:'Cormorant Garamond',serif;font-size:16px;font-weight:400;color:var(--marrom);}\r\n.serv-row-info .meta{font-size:11px;color:rgba(61,43,26,0.4);margin-top:2px;}\r\n.serv-row-preco{font-family:'Cormorant Garamond',serif;font-size:22px;color:var(--dourado);font-weight:300;}\r\n.serv-row-acoes{display:flex;gap:6px;}\r\n\r\n/* FORM NOVO SERVIÇO */\r\n.form-servico{background:#fff;border-radius:12px;border:1px solid var(--creme-escuro);padding:24px;position:sticky;top:20px;}\r\n.form-servico h3{font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:400;color:var(--marrom);margin-bottom:20px;}\r\n.form-servico h3 em{font-style:italic;color:var(--marrom-medio);}\r\n\r\n.ico-sel{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:6px;}\r\n.ico-opt{\r\n  width:36px;height:36px;border-radius:7px;border:1.5px solid var(--creme-escuro);\r\n  background:#fff;display:flex;align-items:center;justify-content:center;\r\n  font-size:16px;cursor:pointer;transition:all 0.2s;color:rgba(61,43,26,0.4);\r\n}\r\n.ico-opt:hover{border-color:rgba(201,169,110,0.4);color:var(--dourado);}\r\n.ico-opt.sel{border-color:var(--dourado);background:rgba(201,169,110,0.1);color:var(--dourado);}\r\n\r\n/* CATEGORIA BADGE */\r\n.cat-badge{\r\n  display:inline-block;padding:3px 10px;border-radius:20px;font-size:10px;letter-spacing:1.5px;\r\n  text-transform:uppercase;font-weight:500;\r\n}\r\n.cat-corte{background:rgba(201,169,110,0.12);color:#6B4226;}\r\n.cat-manicure{background:rgba(192,57,43,0.08);color:#8B1A10;}\r\n.cat-tratamento{background:rgba(76,175,125,0.1);color:#1A5E35;}\r\n.cat-coloracao{background:rgba(142,68,173,0.08);color:#5B2C6F;}\r\n\r\n/* ===================== HISTÓRICO CLIENTE ===================== */\r\n.hist-lista{display:flex;flex-direction:column;gap:12px;}\r\n.hist-item{\r\n  display:flex;align-items:center;gap:16px;padding:18px 22px;\r\n  background:#fff;border-radius:10px;border:1px solid var(--creme-escuro);\r\n}\r\n.hist-data{text-align:center;min-width:52px;}\r\n.hist-data .hd{font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:300;color:var(--marrom);}\r\n.hist-data .hm{font-size:10px;letter-spacing:1px;text-transform:uppercase;color:rgba(61,43,26,0.35);}\r\n.hist-div{width:1px;background:var(--creme-escuro);align-self:stretch;}\r\n.hist-info h4{font-family:'Cormorant Garamond',serif;font-size:16px;color:var(--marrom);}\r\n.hist-info p{font-size:12px;color:rgba(61,43,26,0.45);margin-top:3px;}\r\n.hist-status{margin-left:auto;padding:4px 12px;border-radius:20px;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;}\r\n.hs-confirmado{background:rgba(76,175,125,0.1);color:#1A5E35;}\r\n.hs-pendente{background:rgba(201,169,110,0.12);color:#6B4226;}\r\n.hs-cancelado{background:rgba(192,57,43,0.08);color:#8B1A10;}\r\n.hist-preco{margin-left:16px;font-family:'Cormorant Garamond',serif;font-size:20px;color:var(--dourado);}\r\n\r\n/* ===================== MODAL ===================== */\r\n.overlay{\r\n  position:fixed;inset:0;background:rgba(42,26,14,0.55);z-index:200;\r\n  display:flex;align-items:center;justify-content:center;\r\n  opacity:0;pointer-events:none;transition:opacity 0.3s;\r\n}\r\n.overlay.open{opacity:1;pointer-events:all;}\r\n.modal{\r\n  background:var(--creme);border-radius:16px;padding:32px;max-width:460px;width:92%;\r\n  transform:translateY(18px);transition:transform 0.3s;position:relative;\r\n}\r\n.overlay.open .modal{transform:translateY(0);}\r\n.modal-close{\r\n  position:absolute;top:14px;right:14px;width:30px;height:30px;border-radius:50%;\r\n  border:1px solid var(--creme-escuro);background:#fff;cursor:pointer;\r\n  display:flex;align-items:center;justify-content:center;font-size:15px;color:var(--marrom-medio);transition:all 0.2s;\r\n}\r\n.modal-close:hover{border-color:var(--dourado);color:var(--dourado);}\r\n.modal h3{font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:300;color:var(--marrom);margin-bottom:18px;}\r\n.modal h3 em{font-style:italic;}\r\n\r\n/* ===================== NOTIFICAÇÃO ===================== */\r\n.notif{\r\n  position:fixed;bottom:20px;right:20px;\r\n  background:var(--marrom);color:var(--dourado-claro);\r\n  padding:12px 20px;border-radius:8px;font-size:12px;letter-spacing:0.5px;\r\n  border-left:3px solid var(--dourado);z-index:400;\r\n  transform:translateY(16px);opacity:0;transition:all 0.3s;pointer-events:none;\r\n  display:flex;align-items:center;gap:10px;\r\n}\r\n.notif.show{transform:translateY(0);opacity:1;}\r\n\r\n/* ===================== SELECT ===================== */\r\n.sel-inp{\r\n  width:100%;padding:11px 14px;border:1.5px solid var(--creme-escuro);border-radius:8px;\r\n  font-family:'Jost',sans-serif;font-size:13px;color:var(--texto);background:#fff;outline:none;cursor:pointer;\r\n}\r\n.sel-inp:focus{border-color:var(--dourado);}\r\n\r\n/* ===================== TAG TIPO USUARIO ===================== */\r\n.tipo-tag{\r\n  display:inline-flex;align-items:center;gap:6px;\r\n  padding:4px 12px;border-radius:20px;font-size:10px;letter-spacing:2px;text-transform:uppercase;\r\n  font-weight:500;margin-left:8px;vertical-align:middle;\r\n}\r\n.tipo-tag.cliente{background:rgba(41,128,185,0.1);color:#1A5276;}\r\n.tipo-tag.prof{background:rgba(201,169,110,0.12);color:#6B4226;}\r\n\r\n/* ===================== TABS AGENDA PROF ===================== */\r\n.tabs-agenda{display:flex;gap:0;background:var(--creme-escuro);border-radius:8px;padding:3px;margin-bottom:28px;width:fit-content;}\r\n.tab-btn{\r\n  padding:9px 22px;border-radius:6px;border:none;background:transparent;cursor:pointer;\r\n  font-family:'Jost',sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;\r\n  color:rgba(61,43,26,0.4);transition:all 0.3s;\r\n}\r\n.tab-btn.ativo{background:var(--marrom);color:var(--dourado-claro);}\r\n\r\n/* SCROLL CUSTOM */\r\n::-webkit-scrollbar{width:5px;height:5px;}\r\n::-webkit-scrollbar-track{background:var(--creme-escuro);}\r\n::-webkit-scrollbar-thumb{background:rgba(201,169,110,0.4);border-radius:10px;}\r\n\r\n/* EMPTY STATE */\r\n.empty{text-align:center;padding:48px 24px;}\r\n.empty i{font-size:36px;color:rgba(201,169,110,0.3);display:block;margin-bottom:12px;}\r\n.empty p{font-size:14px;color:rgba(61,43,26,0.35);letter-spacing:0.3px;}\r\n\r\n\r\n/* ===== Status (cores + ícones) e perfil ===== */\r\n.st-pendente{--sc:#E6A23C}.st-confirmado{--sc:#2980B9}.st-concluido{--sc:#4CAF7D}.st-cancelado{--sc:#C0392B}\r\n.chips{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 18px}\r\n.chip{border:1.5px solid var(--sc,var(--marrom));color:var(--sc,var(--marrom));background:#fff;border-radius:20px;padding:6px 14px;font:inherit;font-size:12px;cursor:pointer;display:inline-flex;gap:6px;align-items:center;opacity:.55;transition:all .15s}\r\n.chip.on{background:var(--sc,var(--marrom));color:#fff;opacity:1}\r\n.chip b{font-weight:500;background:rgba(255,255,255,.25);border-radius:10px;padding:0 7px}\r\n.chip:not(.on) b{background:rgba(0,0,0,.06)}\r\n.ev.st{background:#fff;border-left:3px solid var(--sc);color:var(--texto)}\r\n@supports (background:color-mix(in srgb,red,blue)){.ev.st{background:color-mix(in srgb,var(--sc) 14%,#fff)}}\r\n.ev.st .eh i{color:var(--sc)}\r\n.ev.st-cancelado{text-decoration:line-through;opacity:.6}\r\n.hist-item.st{border-left:4px solid var(--sc)}\r\n.hist-item.st .hist-status{background:var(--sc);color:#fff;display:inline-flex;gap:5px;align-items:center}\r\n#sec-perfil .resumo-card{max-width:760px}\r\n#sec-perfil .prof-av{display:flex;align-items:center;justify-content:center;border-radius:50%}\r\n#sec-perfil .prof-av img{width:100%;height:100%;object-fit:cover}\r\n
