<+><!DOCTYPE html>\r\n<html lang=\"pt-br\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Serviços | Una Instituto de Beleza</title>\r\n  <link rel=\"stylesheet\" href=\"/static/css/crud.css\">\r\n</head>\r\n<body>\r\n  <div class=\"crud-wrap\">\r\n    <a class=\"crud-voltar\" href=\"{% url 'agendamentos:home' %}\">&larr; Voltar para a home</a>\r\n\r\n    <div class=\"crud-cabecalho\">\r\n      <h1>Serviços</h1>\r\n      <a class=\"crud-btn\" href=\"{% url 'agendamentos:servico_create' %}\">+ Novo serviço</a>\r\n    </div>\r\n\r\n    <form method=\"get\" class=\"crud-filtros\">\r\n      <input type=\"text\" name=\"q\" placeholder=\"Buscar por nome...\" value=\"{{ q }}\">\r\n      <select name=\"ordenar\" onchange=\"this.form.submit()\">\r\n        <option value=\"nome\" {% if ordenar == \"nome\" %}selected{% endif %}>Nome (A-Z)</option>\r\n        <option value=\"-nome\" {% if ordenar == \"-nome\" %}selected{% endif %}>Nome (Z-A)</option>\r\n        <option value=\"preco\" {% if ordenar == \"preco\" %}selected{% endif %}>Preço (menor primeiro)</option>\r\n        <option value=\"-preco\" {% if ordenar == \"-preco\" %}selected{% endif %}>Preço (maior primeiro)</option>\r\n        <option value=\"categoria\" {% if ordenar == \"categoria\" %}selected{% endif %}>Categoria</option>\r\n      </select>\r\n      <button type=\"submit\" class=\"crud-btn secundario\">Buscar</button>\r\n    </form>\r\n\r\n    {% if servicos %}\r\n    <table class=\"crud-tabela\">\r\n      <thead>\r\n        <tr>\r\n          <th>Nome</th>\r\n          <th>Categoria</th>\r\n          <th>Preço</th>\r\n          <th>Duração</th>\r\n          <th>Ativo</th>\r\n          <th>Ações</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        {% for servico in servicos %}\r\n        <tr>\r\n          <td>{{ servico.nome }}</td>\r\n          <td>{{ servico.get_categoria_display }}</td>\r\n          <td>R$ {{ servico.preco }}</td>\r\n          <td>{{ servico.duracao_min }} min</td>\r\n          <td>{% if servico.ativo %}Sim{% else %}Não{% endif %}</td>\r\n          <td class=\"crud-acoes\">\r\n            <a href=\"{% url 'agendamentos:servico_detail' servico.pk %}\">Ver</a>\r\n            <a href=\"{% url 'agendamentos:servico_update' servico.pk %}\">Editar</a>\r\n            <a class=\"excluir\" href=\"{% url 'agendamentos:servico_delete' servico.pk %}\">Excluir</a>\r\n          </td>\r\n        </tr>\r\n        {% endfor %}\r\n      </tbody>\r\n    </table>\r\n\r\n    {% if is_paginated %}\r\n    <div class=\"crud-paginacao\">\r\n      {% if page_obj.has_previous %}\r\n        <a href=\"?page={{ page_obj.previous_page_number }}&q={{ q }}&ordenar={{ ordenar }}\">&laquo; Anterior</a>\r\n      {% endif %}\r\n      <span class=\"ativo\">Página {{ page_obj.number }} de {{ page_obj.paginator.num_pages }}</span>\r\n      {% if page_obj.has_next %}\r\n        <a href=\"?page={{ page_obj.next_page_number }}&q={{ q }}&ordenar={{ ordenar }}\">Próxima &raquo;</a>\r\n      {% endif %}\r\n    </div>\r\n    {% endif %}\r\n\r\n    {% else %}\r\n    <div class=\"crud-vazio\">\r\n      {% if q %}\r\n        Nenhum serviço encontrado para \"{{ q }}\".\r\n      {% else %}\r\n        Nenhum serviço cadastrado ainda. <a href=\"{% url 'agendamentos:servico_create' %}\">Cadastre o primeiro</a>.\r\n      {% endif %}\r\n    </div>\r\n    {% endif %}\r\n  </div>\r\n</body>\r\n</html>\r\n
