+.topbar,.menu-overlay{display:none}
+@media(max-width:900px){
+  .topbar{display:flex;position:fixed;top:0;left:0;right:0;height:56px;background:var(--marrom);align-items:center;gap:14px;padding:0 14px;z-index:90;border-bottom:1px solid rgba(201,169,110,.25)}
+  .topbar button{background:none;border:0;color:var(--dourado-claro);font-size:26px;cursor:pointer;line-height:1}
+  .topbar span{font-family:'Cormorant Garamond',serif;font-size:20px;letter-spacing:3px;text-transform:uppercase;color:var(--dourado-claro)}
+  .sidebar{transform:translateX(-105%);width:260px;overflow-y:auto}
+  .sidebar.aberto{transform:none;box-shadow:0 0 40px rgba(0,0,0,.45)}
+  .menu-overlay.show{display:block;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:95}
+  .main{margin-left:0;padding-top:56px}
+  .page-header{padding:28px 20px}
+  .conteudo{padding:24px 16px 48px}
+  .grid2,.grid3,.resumo-pag-grid,.pag-grid,.data-grid,.servicos-gestao-grid{grid-template-columns:1fr}
+  .pag-card{position:static}
+  .steps-bar .step{font-size:0;gap:0}
+  .steps-bar .step-num{font-size:11px}
+  .step-linha{margin:0 8px}
+  .stats-bar{flex-wrap:wrap}.stats-bar>*{flex:1 1 40%;min-width:140px}
+  .agenda-wrap{overflow-x:auto}.ag-header,.ag-corpo{min-width:720px}
+  .hist-item{flex-wrap:wrap;gap:10px}
+  #sec-agenda>div:first-child{flex-wrap:wrap;gap:14px}
+  #sec-agenda>div:first-child>div:last-child{width:100%;justify-content:space-between}
+  .modal{width:calc(100% - 32px);max-width:480px}
+  .sucesso-wrap{padding:36px 8px}
+  .titulo-sec{font-size:clamp(26px,7vw,36px)}
+}
+@media(max-width:520px){
+  .grade-servicos{grid-template-columns:1fr 1fr;gap:10px}
+  .grade-prof{grid-template-columns:1fr}
+  .conteudo{padding:20px 12px 40px}
+  .resumo-card{padding:20px 16px}
+  .btn-pri,.btn-sec{padding-left:18px;padding-right:18px}
+}
+
+.pag-acoes button{letter-spacing:1.5px;padding-left:18px;padding-right:18px}
